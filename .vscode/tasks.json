{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build package",
      "type": "npm",
      "script": "build",
      "path": "${workspaceFolder}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "${workspaceFolder}",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Run Jest tests",
      "type": "npm",
      "script": "test",
      "path": "${workspaceFolder}",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
