{
  "name": "@jetblack/converters",
  "version": "0.0.0",
  "description": "Unit conversion with float or fraction arithmetic for Node.js and modern browsers",
  "main": "./dist/index.cjs",
  "author": {
    "name": "Rob Blackbourn",
    "email": "rob.blackbourn@googlemail.com"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild lib/index.ts --bundle --platform=neutral --target=es2020 --format=esm --outfile=dist/index.mjs --sourcemap && esbuild lib/index.ts --bundle --platform=node --target=es2020 --format=cjs --outfile=dist/index.cjs --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 80,
    "arrowParens": "avoid",
    "bracketsSpacing": true,
    "bracketSameLine": false
  }
}
